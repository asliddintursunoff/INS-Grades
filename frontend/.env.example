# Backend REST API URL on Railway (e.g., https://your-backend.up.railway.app)
# If empty or omitted during local development, relative URLs (/api/...) will be used
VITE_API_URL=https://your-backend.up.railway.app

# Telegram Bot username without @ (e.g., your_bot_username)
VITE_BOT_USERNAME=your_bot_username_here
