# Django Settings
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*

# Port for Railway / Gunicorn
PORT=3000

# Database Connection (Option 1: Individual Variables - Recommended for Railway)
DB_HOST=postgres.railway.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=railway
DB_SSLMODE=prefer

# Database Connection (Option 2: Single URL)
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Security & CORS
API_KEY=your_secure_api_key_here
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://*.vercel.app,http://localhost:3000,http://localhost:5173

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
APP_URL=https://your-frontend.vercel.app

# Railway S3-Compatible Object Storage Credentials
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=resilient-module-m3qmihat
S3_ACCESS_KEY_ID=tid_sJKHMdAQGSDbJgIZUOoZltQsaWuUlbGaundBPOmwCdvQIJjMfJ
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
