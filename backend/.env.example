# INS Grades Python FastAPI Backend Environment Variables
PORT=3000

# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=7963381665:AAFljS3q8j5GvFp-7u2vK5Dq5f5mBqW9X5A

# Frontend URL (Vercel deployment)
APP_URL=https://ins-grades.vercel.app

# Railway PostgreSQL Connection (Option 1: Individual Variables - Recommended)
DB_HOST=postgres.railway.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=railway
# Optional SSL mode: disable (for internal railway network) or require (for external proxy)
DB_SSLMODE=

# Railway PostgreSQL Connection (Option 2: Single URL)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Secret Master API Key for protected endpoints (Never expose to frontend!)
API_KEY=ins_secure_api_key_2026_x89a

# Allowed CORS Origins (comma-separated list of trusted client origins)
ALLOWED_ORIGINS=https://ins-grades.vercel.app,http://localhost:3000,http://localhost:5173

# Rate Limiting (maximum requests allowed per minute per IP)
RATE_LIMIT_PER_MINUTE=60
