# Server port (automatically assigned by Railway in production, default 3000)
PORT=3000

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=8234622386:AAGRh0DIzbn4BrG-gGBWiuTzMHu6l0chciE

# Frontend Telegram WebApp URL deployed on Vercel
# (e.g. https://ins-grades.vercel.app)
APP_URL=https://your-frontend-app.vercel.app

# Internal API Secret for Bot-to-API communication
INTERNAL_API_KEY=uni-system-internal-secret-key-2026

# Optional: PostgreSQL Database URL (if you add a PostgreSQL plugin on Railway)
