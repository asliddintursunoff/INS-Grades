# Django Settings
DJANGO_SECRET_KEY=django-insecure-ins-grades-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Port for Railway / Gunicorn
PORT=3000

# Database Connection (Option 1: Individual Variables - Recommended for Railway)
DB_HOST=postgres.railway.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=railway
DB_SSLMODE=prefer

# Database Connection (Option 2: Single URL)
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Security & CORS
API_KEY=ins_secure_api_key_2026_x89a
ALLOWED_ORIGINS=https://ins-grades.vercel.app,http://localhost:3000,http://localhost:5173

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
APP_URL=https://ins-grades.vercel.app
