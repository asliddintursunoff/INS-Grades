# ------------------------------------------------------------------------------
# Timetable Microservice Environment Configuration
# ------------------------------------------------------------------------------

# Database Connection (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@postgres.railway.internal:5432/railway

# Or individual parameters:
# DB_HOST=postgres.railway.internal
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_NAME=railway
# DB_SSLMODE=prefer

# EduPage Source & Screenshot Settings
EDUPAGE_URL=https://iut.edupage.org
CAPTURE_SCREENSHOTS=true
STATIC_URL_PREFIX=/static/timetables
SCREENSHOT_DIR=screenshots

# Railway S3-Compatible Object Storage Credentials
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=resilient-module-m3qmihat
S3_ACCESS_KEY_ID=tid_sJKHMdAQGSDbJgIZUOoZltQsaWuUlbGaundBPOmwCdvQIJjMfJ
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
