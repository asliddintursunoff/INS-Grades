# PORT: Server port (defaults to 3000, dynamically provided on Railway)
PORT=3000

# VITE_API_URL: Public Railway backend URL for Vercel frontend (e.g., https://your-backend.up.railway.app)
VITE_API_URL=https://your-backend.up.railway.app

# VITE_BOT_USERNAME: Telegram Bot username without @
VITE_BOT_USERNAME="INS_gradesbot"

# GEMINI_API_KEY: Optional AI assistant key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where the frontend is hosted (e.g. Vercel deployment URL)
APP_URL="https://ins-grades.vercel.app"

# DATABASE_URL: PostgreSQL connection string on Railway (optional, SQLite embedded by default)
DATABASE_URL="postgresql://postgres:password@host:port/railway"

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN="8234622386:AAGRh0DIzbn4BrG-gGBWiuTzMHu6l0chciE"

# INTERNAL_API_KEY: Shared secret between Bot and Backend API
INTERNAL_API_KEY="uni-system-internal-secret-key-2026"
