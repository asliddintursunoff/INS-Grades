# ==============================================================================
# INS Grades - Environment Configuration Example
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@postgres.railway.internal:5432/railway

# Optional individual DB variables:
# DB_HOST=postgres.railway.internal
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password_here
# DB_NAME=railway
# DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# 2. Django Backend Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*
PORT=3000

# ------------------------------------------------------------------------------
# 3. Security, API & CORS
# ------------------------------------------------------------------------------
API_KEY=your_secure_api_key_here
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://*.vercel.app,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Telegram Bot & Frontend URL
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
APP_URL=https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# 5. Timetable Automation & EduPage Scraper Settings
# ------------------------------------------------------------------------------
EDUPAGE_URL=https://iut.edupage.org
TIMETABLE_OUTPUT_DIR=data
TIMETABLE_SCREENSHOT_DIR=backend/staticfiles/timetables
CAPTURE_SCREENSHOTS=true
SCREENSHOT_HEADLESS=true

# ------------------------------------------------------------------------------
# 6. Railway S3-Compatible Object Storage (Tigris)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=resilient-module-m3qmihat
S3_ACCESS_KEY_ID=tid_sJKHMdAQGSDbJgIZUOoZltQsaWuUlbGaundBPOmwCdvQIJjMfJ
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
