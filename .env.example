# ==============================================================================
# INS Grades - Environment Configuration Example
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# 1. Database Connection
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# 2. Django Backend Settings
DJANGO_SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
PORT=

# 3. Security, API & CORS
API_KEY=
ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# 4. Telegram Bot & Frontend URL
TELEGRAM_BOT_TOKEN=
APP_URL=
U2410252_PASSWORD=

# 5. Timetable Automation & EduPage Scraper Settings
EDUPAGE_URL=
TIMETABLE_OUTPUT_DIR=
TIMETABLE_SCREENSHOT_DIR=
CAPTURE_SCREENSHOTS=
SCREENSHOT_HEADLESS=

# 6. Railway S3-Compatible Object Storage (Tigris)
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 7. Automated P2P Payment Verification & Admin
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
BASE_PREMIUM_PRICE=
PAYMENT_TIMEOUT_MINUTES=
PAYMENT_SECRET_KEY=

# 8. Telethon SMS Listener Settings (payment_worker service)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_STRING=
ALLOWED_SMS_SENDERS=
ADMIN_TELEGRAM_ID=

